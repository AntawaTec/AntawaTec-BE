# =============================================================================
# Variables de entorno para las Edge Functions en LOCAL.
# Uso:  cp supabase/functions/.env.example supabase/functions/.env
#       supabase functions serve --env-file supabase/functions/.env
# El .env real NO se commitea (.gitignore). En hosted estas vars se setean como
# secrets del proyecto (supabase secrets set). SUPABASE_URL y
# SUPABASE_SERVICE_ROLE_KEY las inyecta el runtime solo; NO van acá.
# =============================================================================

# hotmart-webhook + bank-transfer-approval → provisionTenant(redirectTo).
# Con el template custom de invite (config.toml [auth.email.template.invite])
# queda INERTE para el link del email: el template arma la URL con
# {{ .SiteURL }} + {{ .TokenHash }}. Se mantiene por el flujo stock (si el
# template no está activo, p. ej. hosted antes del paso manual del Dashboard).
ONBOARDING_REDIRECT_URL=http://127.0.0.1:3000/auth/callback

# hotmart-webhook: token compartido que Hotmart manda en cada webhook (auth).
HOTMART_HOTTOK=hottok-local-dev

# notification-dispatch: secret del header x-cron-secret (pg_cron → función).
# En local puede quedar vacío (la función permite invocación directa sin secret).
CRON_SECRET=

# _shared/whatsappTransport: sandbox de WhatsApp (RUNBOOK 3.8). Con DRY_RUN=true
# (default) no llama a nadie; las credenciales solo hacen falta para envío real.
WHATSAPP_DRY_RUN=true

# Proveedor de envío: "meta" (default, Cloud API directa) | "twilio" (BSP).
# El dry-run mira las credenciales DEL PROVEEDOR ELEGIDO: poner twilio sin sus
# secrets deja el canal en sandbox, no manda por Meta.
# Ver docs/whatsapp-twilio-setup.md antes de tocarlo (ventana coordinada).
WHATSAPP_PROVIDER=meta

# --- Meta (WHATSAPP_PROVIDER=meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Webhook de recibos de entrega (whatsapp-webhook). El verify token lo inventás vos
# y lo pegás igual en Meta > App > WhatsApp > Configuración; el app secret sale de
# Meta > App > Configuración > Básica.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Twilio (WHATSAPP_PROVIDER=twilio) ---
# SID y token salen de la Console de Twilio (Account Info). El AUTH_TOKEN es
# además el secret con el que se valida la firma de twilio-status-webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sender de WhatsApp, E.164. Con o sin el prefijo "whatsapp:" (el
# transporte lo agrega si falta). Ej.: whatsapp:+593983926448
TWILIO_WHATSAPP_FROM=
# Mapa plantilla → Content SID del Content Template Builder. Twilio NO acepta el
# nombre de la plantilla: exige el HX… Las 6 llaves son los valores del enum
# notification_template. Sin la llave, ese evento falla con error legible.
# Ej.: {"appointment_confirmed":"HXaaa...","quote_ready":"HXbbb..."}
TWILIO_CONTENT_SIDS=
# URL pública de twilio-status-webhook. Se manda como StatusCallback en cada
# envío y es la URL que se usa para VALIDAR la firma (tiene que ser idéntica a
# la que se pega en el sender de Twilio).
TWILIO_STATUS_CALLBACK_URL=

# payphone-prepare / payphone-confirm: credenciales del Botón de Pago (consola
# appdeveloper.payphonetodoesposible.com → pestaña Credenciales). Se usan las de
# la app de PRUEBAS en local y en el primer deploy; pasar a producción es rotar
# estos dos valores, nada de código.
# Las URLs son a dónde vuelve el usuario desde Payphone: RESPONSE_URL recibe
# ?id=&clientTransactionId= y CANCELLATION_URL es a donde cae si cierra el pago.
# En HOSTED se setean con `supabase secrets set` apuntando a la landing:
#   PAYPHONE_RESPONSE_URL=https://www.antwt.com/
#   PAYPHONE_CANCELLATION_URL=https://www.antwt.com/?pago=cancelado
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_RESPONSE_URL=http://localhost:8080/
PAYPHONE_CANCELLATION_URL=http://localhost:8080/?pago=cancelado
